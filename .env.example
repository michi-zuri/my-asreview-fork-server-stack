# =============================================================================
# .env.example  --  The single source of configuration for this stack.
# =============================================================================
#
# Everything ASReview LAB needs is configured here. There is no separate
# config file — Flask reads `ASREVIEW_LAB_*` env vars directly via
# `app.config.from_prefixed_env("ASREVIEW_LAB")`. The prefix is stripped, so
# `ASREVIEW_LAB_SECRET_KEY` becomes `app.config["SECRET_KEY"]`.
#
# HOW TO USE
# ----------
#   * Coolify: paste each variable below into the project's "Environment
#     Variables" tab (replace every CHANGE_ME with a strong value).
#     Coolify writes its own .env at deploy time.
#
#   * Local dev: `cp .env.example .env`, fill in CHANGE_ME values,
#     then `docker compose up`.
#
# GENERATING STRONG SECRETS
# -------------------------
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   # or
#   openssl rand -base64 48
#
# A NOTE ON VALUE PARSING
# -----------------------
# Flask runs each value through `json.loads`, falling back to the raw string
# on failure. So:
#   * Bools: write `true` / `false`  (NOT True/False)
#   * Ints:  write `465`             (becomes int 465)
#   * Strings: write `Lax`           (kept as string when JSON-parse fails)
# Avoid bare values like `null`, `true`, `false` for secrets — they would
# be parsed as None/booleans. Strings generated by `secrets.token_urlsafe`
# are always safe.
# =============================================================================


# --- Gunicorn ---------------------------------------------------------------
# Rule of thumb: (2 × CPU cores) + 1
WORKERS=4


# --- PostgreSQL -------------------------------------------------------------
# Consumed by both the `database` service (initialises the DB) and the
# `asreview` service (builds the SQLAlchemy connection string).
POSTGRES_USER=asreview
POSTGRES_DB=asreview_db
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_string


# --- ASReview: security (REQUIRED) -----------------------------------------
ASREVIEW_LAB_SECRET_KEY=CHANGE_ME_use_a_long_random_string
ASREVIEW_LAB_SECURITY_PASSWORD_SALT=CHANGE_ME_use_a_long_random_string


# --- ASReview: cookies ------------------------------------------------------
# Traefik terminates HTTPS, so browsers always see https://.
ASREVIEW_LAB_SESSION_COOKIE_SECURE=true
ASREVIEW_LAB_REMEMBER_COOKIE_SECURE=true
# "Lax" for single-domain (the default Coolify setup).
# Use "None" only if you split frontend and backend across domains.
ASREVIEW_LAB_SESSION_COOKIE_SAMESITE=Lax


# --- ASReview: authentication ----------------------------------------------
ASREVIEW_LAB_ALLOW_ACCOUNT_CREATION=true
# Requires the MAIL_* settings below.
# ASREVIEW_LAB_EMAIL_VERIFICATION=true


# --- ASReview: email server (optional, needed for email verification) ------
# Example: SendGrid SMTP relay (free ≤ 100 emails/day).
# ASREVIEW_LAB_MAIL_SERVER=smtp.sendgrid.net
# ASREVIEW_LAB_MAIL_PORT=465
# ASREVIEW_LAB_MAIL_USE_TLS=false
# ASREVIEW_LAB_MAIL_USE_SSL=true
# ASREVIEW_LAB_MAIL_USERNAME=apikey
# ASREVIEW_LAB_MAIL_PASSWORD=REPLACE_WITH_SENDGRID_API_KEY
# ASREVIEW_LAB_MAIL_DEFAULT_SENDER=no_reply@example.org
